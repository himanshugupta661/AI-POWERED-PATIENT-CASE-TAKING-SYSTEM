# PatientCase AI - Environment Configuration Example

# Flask Secret Key for Sessions
SECRET_KEY=patientcase-ai-production-secret-change-in-prod-2026

# Environment ('development', 'testing', 'production')
FLASK_CONFIG=development

# Database Connection (defaults to local SQLite in instance/patientcase.db)
# DATABASE_URL=sqlite:///instance/patientcase.db

# AI Provider Configuration
# 'rule_based' (default, guaranteed offline baseline, zero API keys required)
AI_PROVIDER=rule_based

# Server Port
PORT=5000
